{
  "name": "NHBCAP01",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^10",
    "@sap/dev-cap-tools": "^1.31.0",
    "cds-plugin-ui5": "^0.17.0",
    "dotenv": "^17.4.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-customer-ui": "cds watch --open nhb.cap.customer.customerui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "cds": {
    "requires": {
      "TemenosCustomerService": {
        "kind": "odata",
        "model": "srv/external/temenos.cds",
        "credentials": {
          "url": "http://localhost:5001/temenos"
        },
        "[production]": {
          "credentials": {
            "destination": "NHBTEMENOS"
          }
        }
      }
    },
    "[production]": {
      "auth": "xsuaa"
    }
  }
}
