{
  "name": "deploy",
  "dependencies": {
    "hdb": "^2.0.0",
    "@sap/hdi-deploy": "^5"
  },
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "start": "node node_modules/@sap/hdi-deploy/deploy.js --use-hdb --parameter com.sap.hana.di.table/try_fast_table_migration=true --undeploy src/gen/data/NHBCAP01-MurabahaPayment.hdbtabledata src/gen/data/NHBCAP01-Account.hdbtabledata src/gen/data/NHBCAP01-Customer.hdbtabledata src/gen/data/NHBCAP01-MurabahaInstallment.hdbtabledata src/gen/data/NHBCAP01-MurabahaFinancing.hdbtabledata --path-parameter src/gen/data/NHBCAP01-MurabahaPayment.hdbtabledata:skip_data_deletion=true src/gen/data/NHBCAP01-Account.hdbtabledata:skip_data_deletion=true src/gen/data/NHBCAP01-Customer.hdbtabledata:skip_data_deletion=true src/gen/data/NHBCAP01-MurabahaInstallment.hdbtabledata:skip_data_deletion=true src/gen/data/NHBCAP01-MurabahaFinancing.hdbtabledata:skip_data_deletion=true"
  }
}
